# ---- keys (one Solari key covers browsers, sandboxes and desktops) ----
SOLARI_API_KEY=slr_live_...          # https://console.getsolari.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional second provider for "now do GPT" re-runs (any OpenAI-compatible endpoint).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5,gpt-5-mini
# LANPARTY_OPENAI_PRICE_IN=2.5       # $/MTok, for the cost counter
# LANPARTY_OPENAI_PRICE_OUT=10

# ---- the agent ----
LANPARTY_MODEL=claude-opus-5         # default model in the dropdown
LANPARTY_EFFORT=medium               # low | medium | high | xhigh | max (Claude only)
LANPARTY_LLM_CONCURRENCY=8           # seats talking to the model at once (rate-limit gate)
LANPARTY_SEAT_TIMEOUT_MS=480000      # wall clock per seat, 8 min
LANPARTY_COST_CEILING_USD=40         # stop the party past this spend

# ---- plan limits (Starter: 20 browsers, 2 sandboxes/desktops; Free: 3 / 1) ----
LANPARTY_MAX_K=20
LANPARTY_MAX_DESKTOP_SEATS=2
LANPARTY_STAGGER_MS=250

# ---- server ----
PORT=8787
PUBLIC_URL=http://localhost:5173     # used for share links + OG image URLs
# DEMO_MODE=1                        # replayed seats, no keys needed (or: npm run dev:demo)
